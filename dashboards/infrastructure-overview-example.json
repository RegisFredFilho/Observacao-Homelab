                        },
                        "tags": {
                          "filter": ""
                        },
                        "textFilter": "",
                        "trigger": {
                          "filter": ""
                        }
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "reduce",
                  "spec": {
                    "options": {
                      "includeTimeField": false,
                      "mode": "seriesToRows",
                      "reducers": [
                        "lastNotNull"
                      ]
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {},
                      "includeByName": {},
                      "indexByName": {},
                      "orderByMode": "manual",
                      "renameByName": {
                        "Field": "Container",
                        "Last *": "Estado"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.4",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "frameIndex": 0,
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "1": {
                          "text": "Stopped",
                          "color": "semi-dark-red",
                          "index": 1
                        },
                        "2": {
                          "text": "Running",
                          "color": "semi-dark-green",
                          "index": 0
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false,
                    "styleField": "Last *"
